# PayPal AI Hackathon Sandbox Environment Template
# Copy to .env.local (never commit real secrets to GitHub)

# 1. PayPal Sandbox REST App Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# 2. Pre-Generated PayPal Sandbox Test Accounts (https://developer.paypal.com/dashboard/accounts)
PAYPAL_SANDBOX_MERCHANT_EMAIL=sb-merchant@business.example.com
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com

# 3. AI Model Provider Key (Server-Side Only)
GEMINI_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# 4. Optional Sponsor Keys (Unlock Stackable Sponsor Prizes)
# Channel3: https://trychannel3.com/developers (Promo code: PAYPAL-HACKATHON-2026 for 20,000 free searches)
CHANNEL3_API_KEY=
# AG Studio 45-Day Free Trial Key: https://www.ag-grid.com/studio/
AG_STUDIO=
